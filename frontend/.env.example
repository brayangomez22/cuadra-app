# Copy to .env.local (git-ignored). Vite reads it in `npm run dev` and `npm run build`.

# Sentry DSN of the frontend project (cuadra-front › Settings › Client Keys).
# Empty = error reporting disabled. Not a secret: it ends up in the public bundle.
VITE_SENTRY_DSN=
# development | staging | production. Empty = Vite's mode.
VITE_APP_ENV=
# Build name in Sentry; the CI sets the git SHA. Empty locally.
VITE_RELEASE=
