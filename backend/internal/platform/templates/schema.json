{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuadra.app/schemas/business-template.json",
  "title": "Plantilla de tipo de negocio",
  "description": "Lo que siembra una plantilla al registrar una empresa (backend/templates/business/*.yaml). El ID de la plantilla es el nombre del archivo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "modules", "default_tax_rate", "units", "categories", "attributes", "variant_axes", "customer_segments"],
  "properties": {
    "name": { "$ref": "#/$defs/text", "description": "Nombre que ve quien se registra." },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "modules": {
      "description": "Módulos activos desde el registro; deben estar registrados y traer sus dependencias.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
    },
    "default_tax_rate": {
      "description": "Tasa de IVA que el formulario de producto propone, como fracción decimal en texto (\"0.19\" es 19 %).",
      "type": "string",
      "pattern": "^0(\\.\\d{1,4})?$"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^\\S+$" },
          "name": { "$ref": "#/$defs/text" }
        }
      }
    },
    "categories": {
      "description": "Categorías raíz.",
      "type": "array",
      "items": { "$ref": "#/$defs/text" }
    },
    "attributes": {
      "description": "Atributos de producto. Uno con 'required' debe tener valor en todo producto.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "type"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,49}$" },
          "label": { "$ref": "#/$defs/text" },
          "type": { "enum": ["text", "number", "list", "boolean"] },
          "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
          "required": { "type": "boolean" }
        },
        "if": { "properties": { "type": { "const": "list" } } },
        "then": { "required": ["options"] },
        "else": { "not": { "required": ["options"] } }
      }
    },
    "variant_axes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "values"],
        "properties": {
          "name": { "$ref": "#/$defs/text" },
          "values": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
        }
      }
    },
    "customer_segments": {
      "description": "Segmentos de cliente. Se validan aquí y se siembran a partir de T31.",
      "type": "array",
      "items": { "$ref": "#/$defs/text" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" }
  }
}
