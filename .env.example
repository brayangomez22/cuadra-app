# Copy to .env (git-ignored) and adjust. `make` loads it automatically.

# development | staging | production
APP_ENV=development
HTTP_ADDR=:8080
# Required. The API connects as app_user: no superuser, no BYPASSRLS, owns no
# table. It refuses to start otherwise.
DATABASE_URL=postgres://app_user:app_user@localhost:5432/cuadra?sslmode=disable
# `make migrate` only: connects as the schema owner and sets app_user's password.
MIGRATION_DATABASE_URL=postgres://cuadra:cuadra@localhost:5432/cuadra?sslmode=disable
APP_DB_PASSWORD=app_user
# debug | info | warn | error
LOG_LEVEL=info
# Max time to drain in-flight requests on shutdown (Go duration).
SHUTDOWN_TIMEOUT=15s

# OpenTelemetry (standard OTEL_* variables). The API exports traces, metrics
# and logs over OTLP/HTTP to the local Collector (`make obs-up`).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# true = run without telemetry (no Collector needed).
OTEL_SDK_DISABLED=false
