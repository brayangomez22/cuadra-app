# Copy to .env (git-ignored) and adjust. `make` loads it automatically.

# development | staging | production
APP_ENV=development
HTTP_ADDR=:8080
# Required. The API connects as app_user: no superuser, no BYPASSRLS, owns no
# table. It refuses to start otherwise.
DATABASE_URL=postgres://app_user:app_user@localhost:5432/cuadra?sslmode=disable
# Required. Signs the JWT access tokens (HS256): at least 32 bytes. Generate
# one with `openssl rand -base64 48`; in Azure it comes from Key Vault.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Optional, only while rotating JWT_SECRET: the previous secret still
# verifies the access tokens it signed (they live 15 minutes). Remove it
# after that.
JWT_SECRET_PREVIOUS=
# `make migrate` only: connects as the schema owner and sets app_user's password.
MIGRATION_DATABASE_URL=postgres://cuadra:cuadra@localhost:5432/cuadra?sslmode=disable
APP_DB_PASSWORD=app_user
# debug | info | warn | error
LOG_LEVEL=info
# Max time to drain in-flight requests on shutdown (Go duration).
SHUTDOWN_TIMEOUT=15s

# OpenTelemetry (standard OTEL_* variables). The API exports traces, metrics
# and logs over OTLP/HTTP to the local Collector (`make obs-up`).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# true = run without telemetry (no Collector needed).
OTEL_SDK_DISABLED=false

# Sentry, errors only (traces and metrics stay in OpenTelemetry). Every Error
# log becomes an event. Empty = disabled. The DSN is in the cuadra-back project
# settings (Client Keys); in Azure it comes from Key Vault.
SENTRY_DSN=
# Build name shown in Sentry. Empty = the git revision the binary was built from.
SENTRY_RELEASE=

# Demo tenants (T34). `make seed` generates them with this password, which
# their users share (it is public on purpose: the demo is). DEMO_ENABLED=true
# makes the API reset them every night at 3:00 (Bogotá) and lets anyone enter
# them without a password from the login («Probar la demo», T34a).
DEMO_ENABLED=false
DEMO_PASSWORD=demo-cuadra-2026

# Electronic documents of the DIAN (T36): the technology provider that issues
# them. "simulated" never reaches the DIAN (its documents have no legal
# value) and is the default outside production, where it is rejected. The
# real provider (muisca) arrives with T36d.
INVOICING_PROVIDER=simulated

# Key that encrypts each tenant's token at the technology provider before it
# reaches the database: 32 bytes in base64 (openssl rand -base64 32).
# Required in production (Key Vault, T45); empty outside production uses a
# fixed development key. To rotate it, move the old key to
# INVOICING_TOKEN_KEY_PREVIOUS: each stored token is encrypted again with the
# new key the next time it is read.
INVOICING_TOKEN_KEY=
INVOICING_TOKEN_KEY_PREVIOUS=

# The API's edge (T38). TRUSTED_PROXIES: comma-separated IPs or CIDR ranges of
# the proxies (the cloud's ingress) whose X-Forwarded-For names the client;
# empty ignores the header (local development has no proxy).
TRUSTED_PROXIES=
# CORS_ALLOWED_ORIGINS: comma-separated origins (https://app.example.com) that
# may call the API from a browser. Empty: only the API's own origin, which is
# how the app is served (Vite's proxy in development).
CORS_ALLOWED_ORIGINS=
# RATE_LIMITS_ENABLED: requests per client IP and per tenant, and sign-ups per
# IP. On by default; only the end-to-end and DAST stacks turn it off, and
# production cannot.
RATE_LIMITS_ENABLED=true

# --- Feature flags (T39) ---
# PLATFORM_OPERATORS: comma-separated user IDs of the Cuadra team who manage
# the feature flags at /interno/flags. Empty: nobody (the screen answers 404).
PLATFORM_OPERATORS=
# FEATURE_FLAGS_CACHE_TTL: how long each API instance reuses what it read of
# the flags; a change reaches every instance within it. Default 30s.
FEATURE_FLAGS_CACHE_TTL=30s

# --- Usage analytics and feedback (T40) ---
# ANALYTICS_SECRET: key of the users' pseudonyms in the usage analytics (at
# least 32 bytes). Empty: /me brings no analytics_id and the app sends nothing.
ANALYTICS_SECRET=
# FEEDBACK_WEBHOOK_URL: the team's chat webhook (Slack, Discord, Google Chat)
# for the comments of "Danos tu opinión". Empty: they are only logged.
FEEDBACK_WEBHOOK_URL=
